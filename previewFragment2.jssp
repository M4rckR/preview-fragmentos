<%@ page import="xtk:shared/nl.js" %>
<%
// ==========================================================================
// PENDIENTE DE SEGURIDAD - VERSION DE PRUEBA, SIN LOGIN
// Esta version NO exige sesion: cualquiera que abra la URL ejecuta las
// consultas con el operador interno "neolane" (permisos de administrador) y
// puede listar y leer CUALQUIER template cambiando el frgId.
// Es aceptable solo para probar en un ambiente de stage. Antes de dejarla fija
// (y siempre en produccion) hay que volver a poner el bloque de login:
//
//   NL.require("/nl/core/shared/core.js").require("/nl/core/jsspcontext.js");
//   var PAGINA = "/cus/previewFragment.jssp";
//   var jsspContext = new NL.JSSPContext(request);
//   if (!jsspContext.checkAuthentication()) {
//     var target = PAGINA + (selAttr ? "?frgId=" + selAttr : "");
//     response.sendRedirect("/nl/jsp/logon.jsp?target=" + encodeURIComponent(target));
//     return;
//   }
//
// y, ademas, validar que el operador tenga derecho (hasNamedRight o grupo)
// antes de escalar. Ver QA-CAMPAIGN.md.
// ==========================================================================

// frgId: solo digitos
var selectedFrgId = request.parameters.frgId;
if (selectedFrgId && !/^\d+$/.test(String(selectedFrgId))) selectedFrgId = null;
var selAttr = selectedFrgId ? String(selectedFrgId) : "";
// DIAGNOSTICO TEMPORAL: revertir despues de la prueba.
var diag = selectedFrgId && String(request.parameters.diag) === "1";
var diagTxt = "";
// Texto inerte: solo ASCII imprimible y sin < > & " ' (nada de HTML).
function diagLimpia(v) {
  return String(v).replace(/[^\x20-\x7e]/g, "?").replace(/[<>&"']/g, "_");
}
// Filas de nms:includeView (id | name | label | type) que cumplen cond, sin filtro de @type.
function diagSeccion(titulo, cond, max) {
  var out = "\n\n== " + titulo;
  try {
    var res = xtk.queryDef.create(
      <queryDef schema="nms:includeView" operation="select" lineCount={String(max)}>
        <select>
          <node expr="@id"/>
          <node expr="@name"/>
          <node expr="@label"/>
          <node expr="@type"/>
        </select>
        <where>
          <condition expr={cond}/>
        </where>
      </queryDef>
    ).ExecuteQuery();
    var n = 0, ls = [];
    for each (var r in res.*) {
      n++;
      ls.push(diagLimpia(r.@id) + " | " + diagLimpia(r.@name) + " | " + diagLimpia(r.@label) + " | " + diagLimpia(r.@type));
    }
    out += " -> " + n + " fila(s)" + (n >= max ? " (tope " + max + ")" : "") + (n ? "\n" + ls.join("\n") : "");
  } catch (e) {
    out += " -> ERROR: " + diagLimpia(e).slice(0, 300);
  }
  return out;
}
// Valores distintos de @type con su cantidad de filas, y 5 filas de ejemplo por cada uno.
function diagTipos() {
  var out = "\n\n== TIPOS: @type y cantidad de filas", tipos = [];
  try {
    var res = xtk.queryDef.create(
      <queryDef schema="nms:includeView" operation="select">
        <select>
          <node expr="@type"/>
          <node expr="Count(@id)" alias="@cnt"/>
        </select>
        <groupBy>
          <node expr="@type"/>
        </groupBy>
      </queryDef>
    ).ExecuteQuery();
    for each (var r in res.*) {
      var t = String(r.@type), c = String(r.@cnt);
      out += "\ntype " + diagLimpia(t) + " -> " + (c !== "" ? diagLimpia(c) : "(sin cnt) " + diagLimpia(r.toXMLString()).slice(0, 200));
      if (/^\d+$/.test(t)) tipos.push(t);
    }
  } catch (e) {
    out += " -> ERROR: " + diagLimpia(e).slice(0, 300);
  }
  for (var i = 0; i < tipos.length; i++) out += diagSeccion("Ejemplos de @type=" + tipos[i], "@type=" + tipos[i], 5);
  return out;
}

var fragments = null;
var fragmentHtml = "";
var org_ctx = logonEscalation("neolane");   // fuera del try
try {
  fragments = xtk.queryDef.create(
    <queryDef schema="nms:includeView" operation="select">
      <select>
        <node expr="@id"/>
        <node expr="@label"/>
      </select>
      <where>
        <condition expr="@type=1"/>
      </where>
    </queryDef>
  ).ExecuteQuery();
  if (selectedFrgId) {
    var fragment = NLWS.nmsIncludeView.load(selectedFrgId);
    // DIAGNOSTICO TEMPORAL (?diag=1): revertir despues de la prueba.
    // Solo nombres de atributos + valor de name/internalName/label. Nunca el HTML.
    if (diag && fragment) try {
      var lineas = [], dx = fragment.toXML();
      for each (var at in dx.@*) {
        var an = String(at.name().localName);
        if (/^[A-Za-z0-9_:-]+$/.test(an)) lineas.push("@" + an);
      }
      var claves = ["name", "internalName", "label"];
      for (var ci = 0; ci < claves.length; ci++) {
        var cv = dx.@[claves[ci]];
        lineas.push(claves[ci] + " = " + (cv.length() ? encodeURIComponent(cv.toString()) : "(no existe)"));
      }
      diagTxt = "raiz: " + String(dx.name().localName).replace(/[^A-Za-z0-9_:-]/g, "") + "\n" + lineas.join("\n");
    } catch (eDiag) { diagTxt = "diag: no se pudo leer la entidad con toXML()"; }
    if (diag) {
      diagTxt += diagSeccion("A) @name LIKE 'VIEW%'", "@name LIKE 'VIEW%'", 20);
      diagTxt += diagSeccion("B) @name = 'VIEW136'", "@name = 'VIEW136'", 20);
      diagTxt += diagSeccion("B) @name = 'VIEW140'", "@name = 'VIEW140'", 20);
      diagTxt += diagSeccion("C) @id = 136", "@id = 136", 20);
      diagTxt += diagSeccion("C) @id = 140", "@id = 140", 20);
      diagTxt += diagSeccion("C) @id = 257", "@id = 257", 20);
      diagTxt += diagTipos();
    }
    if (fragment) {
      if (fragment.source.html)
        fragmentHtml = fragment.source.html.toString();
      else
        fragmentHtml = "<p style='color:red'>No html</p>";
    }
  }
}
finally {
  logonWithContext(org_ctx);
}

// Lista "id|etiqueta,id|etiqueta" con cada parte codificada: los datos viajan
// como texto inerte (sin & < > ") y el navegador arma el HTML con textContent.
var items = [];
if (fragments != null) {
  for each (var frg in fragments.*) {
    items.push(encodeURIComponent(frg.@id.toString()) + "|" + encodeURIComponent(frg.@label.toString()));
  }
}
var datosLista = items.join(",");
var datosHtml = fragmentHtml != "" ? encodeURIComponent(fragmentHtml) : "";
%>
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Preview de templates</title>
<style>
:root {
  --bar-bg:#1e293b; --bar-field-bg:#0f172a; --bar-fg:#fff; --bar-fg-muted:rgba(255,255,255,.62);
  --acento:#4f46e5; --acento-claro:#a5b4fc;
  --vars-bg:#eef2ff; --vars-border:#c7d2fe; --vars-label:#4338ca;
  --canvas-bg:#f1f5f9; --frame-border:#cbd5e1; --panel-bg:#fff;
  --text:#1e293b; --text-muted:#64748b; --linea:#e2e8f0;
  --warn-bg:#fef3c7; --warn-fg:#92400e; --muestra-borde:#d97706;
  --err-bg:#fee2e2; --err-fg:#991b1b;
  --wf-bg:#0284c7; --wf-hover:#0369a1; --wf-ok:#16a34a; --wf-err:#dc2626;
  --font:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  --font-mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --fs-xs:11px; --fs-sm:12px; --fs-md:13px;
  --radius-field:4px; --radius-btn:5px; --radius-chip:3px;
  --gap:8px; --pad-bar:8px 12px; --panel-w:308px;
}
* { box-sizing:border-box; }
body { margin:0; font:var(--fs-md)/1.45 var(--font); background:var(--canvas-bg); color:var(--text);
       display:flex; flex-direction:column; height:100vh; overflow:hidden; }
.mono { font-family:var(--font-mono); }
:focus-visible { outline:2px solid var(--acento); outline-offset:2px; }
.barra :focus-visible, .combo__campo:focus-within { outline:2px solid var(--acento-claro); outline-offset:1px; }

/* ---------- barra ---------- */
.barra { display:flex; align-items:center; gap:var(--gap); padding:var(--pad-bar);
         background:var(--bar-bg); color:var(--bar-fg); flex:none; flex-wrap:wrap; }
.barra__t { font-weight:600; font-size:var(--fs-sm); flex:none; }
.barra__lb { font-size:var(--fs-xs); color:var(--bar-fg-muted); flex:none; }
.barra__e { font-size:var(--fs-xs); color:var(--bar-fg-muted); flex:none;
            max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.barra__sep { width:1px; align-self:stretch; background:rgba(255,255,255,.16); margin:0 2px; flex:none; }
.barra__esp { flex:1 1 12px; min-width:0; }
.barra__btn { font:inherit; font-size:var(--fs-sm); padding:5px 10px; border:1px solid rgba(255,255,255,.18);
              border-radius:var(--radius-btn); background:transparent; color:var(--bar-fg); cursor:pointer; white-space:nowrap; }
.barra__btn:hover { background:rgba(255,255,255,.10); }
.barra__btn[aria-pressed="true"] { background:var(--acento); border-color:var(--acento); }
.barra__btn:disabled { opacity:.45; cursor:not-allowed; }
.barra__seg, .barra__zoom { display:flex; align-items:center; gap:2px; background:var(--bar-field-bg);
                            border:1px solid rgba(255,255,255,.14); border-radius:var(--radius-btn); padding:2px; flex:none; }
.barra__seg .barra__btn, .barra__zoom .barra__btn { border:0; padding:3px 9px; }
.barra__zoom output { font-size:var(--fs-xs); min-width:38px; text-align:center; color:var(--bar-fg-muted); }
.barra__wf { font:inherit; font-size:var(--fs-sm); font-weight:600; padding:5px 12px; border:0;
             border-radius:var(--radius-btn); background:var(--wf-bg); color:#fff; cursor:pointer; white-space:nowrap; }
.barra__wf:hover { background:var(--wf-hover); }
.barra__wf:disabled { background:#475569; color:rgba(255,255,255,.6); cursor:not-allowed; }

/* ---------- combobox ---------- */
.combo { position:relative; flex:1 1 280px; min-width:180px; max-width:420px; }
.combo__campo { display:flex; align-items:center; gap:6px; background:var(--bar-field-bg);
                border:1px solid rgba(255,255,255,.18); border-radius:var(--radius-field); padding:3px 6px; }
.combo__campo input { flex:1; min-width:0; font:inherit; font-size:var(--fs-xs); border:0; outline:0;
                      background:transparent; color:var(--bar-fg); }
.combo__campo input::placeholder { color:rgba(255,255,255,.45); }
.combo__id { font-family:var(--font-mono); font-size:10px; color:var(--bar-fg-muted); flex:none; }
.combo__fl { color:var(--bar-fg-muted); font-size:9px; flex:none; }
.combo__lista { position:absolute; z-index:40; top:calc(100% + 4px); left:0; right:0; max-height:320px;
                overflow:auto; background:#fff; color:var(--text); border:1px solid var(--frame-border);
                border-radius:6px; box-shadow:0 8px 24px rgba(15,23,42,.22); padding:4px; display:none; }
.combo--abierto .combo__lista { display:block; }
.combo__gt { font-size:10px; letter-spacing:.08em; text-transform:uppercase; color:var(--text-muted);
             padding:6px 8px 3px; font-weight:700; }
.combo__item { display:flex; align-items:baseline; gap:8px; padding:5px 8px; border-radius:var(--radius-field); cursor:pointer; }
.combo__item:hover { background:#f8fafc; }
.combo__item--activo { background:var(--vars-bg); box-shadow:inset 0 0 0 1px var(--vars-border); }
.combo__nom { flex:1; min-width:0; font-size:var(--fs-sm); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.combo__item .combo__id { color:var(--text-muted); }
.combo__marca { background:#fde68a; border-radius:2px; }
.combo__vacio { padding:10px 8px; font-size:var(--fs-sm); color:var(--text-muted); }

/* ---------- avisos ---------- */
.avisos { display:flex; align-items:center; gap:var(--gap); flex-wrap:wrap; flex:none;
          padding:6px 12px; font-size:var(--fs-xs); background:var(--warn-bg); color:var(--warn-fg);
          border-bottom:1px solid rgba(146,64,14,.22); }
.avisos:empty, .avisos[hidden] { display:none; }
.avisos--error { background:var(--err-bg); color:var(--err-fg); border-bottom-color:rgba(153,27,27,.22); }
.avisos__b { font:inherit; font-size:var(--fs-xs); background:transparent; border:1px solid currentColor;
             border-radius:var(--radius-chip); color:inherit; padding:2px 8px; cursor:pointer; }
.detalle { flex:none; display:none; gap:24px; padding:10px 12px; background:#fff;
           border-bottom:1px solid var(--linea); font-size:var(--fs-xs); overflow:auto; max-height:200px; }
.detalle--abierto { display:flex; }
.detalle__col { flex:1; min-width:180px; }
.detalle__t { font-weight:700; color:var(--vars-label); margin-bottom:4px; }
.detalle ul { margin:0; padding-left:16px; }
.detalle li { margin-bottom:2px; word-break:break-word; }

/* ---------- cuerpo ---------- */
.cuerpo { flex:1; display:flex; min-height:0; }
.panel { width:var(--panel-w); flex:none; background:var(--panel-bg); border-right:1px solid var(--linea);
         overflow:auto; padding:10px 12px 20px; }
.panel[hidden] { display:none; }
.panel__cab { display:flex; align-items:center; gap:6px; margin-bottom:10px; }
.panel__t { font-size:var(--fs-sm); font-weight:700; margin-right:auto; }
.panel__n { font-size:var(--fs-xs); color:var(--text-muted); }
.panel__b { font:inherit; font-size:var(--fs-xs); border:1px solid var(--linea); background:#fff;
            border-radius:var(--radius-chip); padding:2px 7px; cursor:pointer; color:var(--text-muted); }
.panel__b:hover { background:#f8fafc; color:var(--text); }
.panel__vacio { font-size:var(--fs-xs); color:var(--text-muted); }

.vars__g { border:1px solid var(--vars-border); background:var(--vars-bg); border-radius:6px;
           padding:8px; margin-bottom:8px; }
.vars__cab { display:flex; align-items:baseline; gap:6px; margin-bottom:6px; }
.vars__nom { font-family:var(--font-mono); font-size:var(--fs-xs); font-weight:700; color:var(--vars-label);
             overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.vars__tipo { font-size:10px; color:var(--text-muted); margin-left:auto; white-space:nowrap; }
.vars__seg { display:grid; grid-template-columns:1fr 1fr; gap:4px; }
.vars__seg--uno { grid-template-columns:1fr; }
.vars__seg button { font:inherit; font-size:var(--fs-xs); padding:4px 6px; border:1px solid var(--vars-border);
                    background:#fff; color:var(--text); border-radius:var(--radius-chip); cursor:pointer;
                    overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.vars__seg button:hover { background:#f8fafc; }
.vars__seg button[aria-pressed="true"] { background:var(--acento); border-color:var(--acento); color:#fff; font-weight:600; }
.vars__sw { display:flex; align-items:center; gap:6px; width:100%; font:inherit; font-size:var(--fs-xs);
            background:#fff; border:1px solid var(--vars-border); border-radius:var(--radius-chip);
            padding:4px 6px; cursor:pointer; color:var(--text); text-align:left; }
.vars__sw + .vars__sw { margin-top:4px; }
.vars__sw:hover { background:#f8fafc; }
.vars__sw .sw__n { flex:1; min-width:0; font-family:var(--font-mono); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.vars__sw .sw__e { flex:none; font-weight:600; }
.vars__sw .sw__p { flex:none; width:26px; height:14px; border-radius:7px; background:#cbd5e1; position:relative; }
.vars__sw .sw__p::after { content:""; position:absolute; top:2px; left:2px; width:10px; height:10px;
                          border-radius:50%; background:#fff; }
.vars__sw[aria-checked="true"] .sw__p { background:var(--acento); }
.vars__sw[aria-checked="true"] .sw__p::after { left:14px; }
.vars__sw[aria-checked="mixed"] .sw__p { background:var(--acento); opacity:.55; }
.vars__sw[aria-checked="mixed"] .sw__p::after { left:8px; }
.vars__sw--todos { background:transparent; border-style:dashed; margin-bottom:4px; }

.ramas { border-top:1px solid var(--linea); margin-top:12px; padding-top:10px; }
.ramas__t { font-size:var(--fs-xs); font-weight:700; color:var(--vars-label); margin-bottom:6px; }
.ramas__f { display:flex; align-items:baseline; gap:6px; font-size:var(--fs-xs); margin-bottom:3px; }
.ramas__g { color:var(--text-muted); flex:none; }
.ramas__chip { font-family:var(--font-mono); font-size:10px; background:var(--vars-bg); color:var(--vars-label);
               border:1px solid var(--vars-border); border-radius:var(--radius-chip); padding:1px 6px;
               overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.ramas__chip--sin { background:var(--warn-bg); color:var(--warn-fg); border-color:rgba(146,64,14,.3); }

/* ---------- lienzo ---------- */
.lienzo { flex:1; min-width:0; overflow:auto; padding:16px; display:flex; justify-content:center; align-items:flex-start; }
.marco { background:#fff; border:1px solid var(--frame-border); border-radius:4px;
         transform-origin:top center; display:flex; flex-direction:column; flex:none; }
.marco--muestra { border-top:3px solid var(--muestra-borde); }
.lienzo__cinta { display:flex; align-items:center; gap:8px; padding:4px 8px; font-size:10px;
                 background:var(--warn-bg); color:var(--warn-fg); border-bottom:1px solid rgba(146,64,14,.2); }
.lienzo__cinta b { font-weight:700; }
.lienzo__cinta button { margin-left:auto; font:inherit; font-size:10px; background:#fff; color:inherit;
                        border:1px solid currentColor; border-radius:var(--radius-chip); padding:1px 6px; cursor:pointer; }
.marco iframe { display:block; border:0; background:#fff; }
.espera { margin:auto; color:var(--text-muted); font-size:var(--fs-md); text-align:center; }

/* ---------- modal Workfront ---------- */
.modal { position:fixed; inset:0; background:rgba(15,23,42,.55); display:none;
         align-items:center; justify-content:center; padding:20px; z-index:60; }
.modal--abierto { display:flex; }
.modal__caja { background:#fff; border-radius:8px; width:520px; max-width:100%; max-height:90vh; overflow:auto;
               box-shadow:0 20px 50px rgba(15,23,42,.35); }
.modal__cab { display:flex; align-items:center; gap:8px; padding:12px 16px; border-bottom:1px solid var(--linea); }
.modal__cab h2 { margin:0; font-size:var(--fs-md); font-weight:700; flex:1; }
.modal__x { font:inherit; border:0; background:transparent; cursor:pointer; color:var(--text-muted); font-size:14px; padding:2px 6px; }
.modal__cuerpo { padding:12px 16px; font-size:var(--fs-sm); }
.modal__f { display:flex; gap:10px; padding:5px 0; border-bottom:1px solid var(--linea); align-items:baseline; }
.modal__k { width:86px; flex:none; color:var(--text-muted); font-size:var(--fs-xs); }
.modal__v { flex:1; min-width:0; word-break:break-word; }
.modal__nota { margin-top:10px; background:var(--warn-bg); color:var(--warn-fg); border-radius:4px; padding:8px 10px; font-size:var(--fs-xs); }
.modal__pie { display:flex; gap:8px; justify-content:flex-end; padding:12px 16px; border-top:1px solid var(--linea); }
.modal__pie button { font:inherit; font-size:var(--fs-sm); padding:6px 14px; border-radius:var(--radius-btn); cursor:pointer; }
.modal__cancel { background:#fff; border:1px solid var(--frame-border); color:var(--text); }
.modal__ok { background:var(--wf-bg); border:1px solid var(--wf-bg); color:#fff; font-weight:600; }
.modal__ok:disabled { opacity:.6; cursor:not-allowed; }

@media (max-width:1100px) {
  .barra__t, .barra__lb, .barra__e { display:none; }
}
@media (max-width:900px) {
  .panel { position:absolute; z-index:30; top:auto; left:0; height:auto; max-height:70vh;
           box-shadow:0 10px 30px rgba(15,23,42,.22); }
  .cuerpo { position:relative; }
}
</style>
</head>
<body>
<% if (diagTxt != "") { %><pre><%= diagTxt %></pre><% return; } %>
  <div class="barra" role="toolbar" aria-label="Acciones del preview">
    <span class="barra__t">Preview de templates</span>
    <span class="barra__lb" id="lbCombo">Template</span>
    <div class="combo" id="combo" data-frags="<%= datosLista %>" data-sel="<%= selAttr %>">
      <div class="combo__campo">
        <input id="buscar" type="text" autocomplete="off" spellcheck="false"
               placeholder="Buscar template o id" aria-labelledby="lbCombo"
               role="combobox" aria-expanded="false" aria-controls="lista" aria-autocomplete="list">
        <span class="combo__id" id="comboId"></span>
        <span class="combo__fl" aria-hidden="true">&#x25BC;</span>
      </div>
      <div class="combo__lista" id="lista" role="listbox" aria-label="Templates"></div>
    </div>
    <span class="barra__e" id="info">guardado en Campaign</span>
    <span class="barra__esp"></span>
    <div class="barra__seg" role="group" aria-label="Dispositivo">
      <button type="button" class="barra__btn" id="escritorio" aria-pressed="true">Escritorio</button>
      <button type="button" class="barra__btn" id="movil" aria-pressed="false">M&oacute;vil</button>
    </div>
    <div class="barra__zoom" role="group" aria-label="Zoom">
      <button type="button" class="barra__btn" id="zmenos" aria-label="Alejar">&#x2212;</button>
      <output id="zval" for="zmenos zmas">100%</output>
      <button type="button" class="barra__btn" id="zmas" aria-label="Acercar">+</button>
    </div>
    <button type="button" class="barra__btn" id="descargar">Descargar .html</button>
    <button type="button" class="barra__btn" id="enlace">Copiar enlace</button>
    <span class="barra__sep" aria-hidden="true"></span>
    <button type="button" class="barra__wf" id="workfront">Enviar a Workfront &#x2197;</button>
  </div>

  <div class="avisos" id="avisos" role="status" hidden></div>
  <div class="detalle" id="detalle"></div>

  <div class="cuerpo">
    <aside class="panel" id="panel" aria-label="Escenario">
      <div class="panel__cab">
        <span class="panel__t">Escenario</span>
        <span class="panel__n" id="panelN"></span>
        <button type="button" class="panel__b" id="restablecer">Restablecer</button>
        <button type="button" class="panel__b" id="cerrarPanel" aria-label="Ocultar panel">&#x25C0;</button>
      </div>
      <div id="vars"></div>
      <div class="ramas" id="ramas"></div>
    </aside>
    <main class="lienzo" id="lienzo">
      <% if (fragmentHtml != "") { %>
      <div class="marco" id="marco">
        <div class="lienzo__cinta" id="cinta">
          <b>&#x25C6; Datos de muestra (ficticios)</b>
          <span id="cintaTxt">muestra</span>
          <button type="button" id="modoMuestra">muestra / [CAMPOS]</button>
        </div>
        <iframe id="vista" width="700" height="100%" sandbox="" referrerpolicy="no-referrer"
                title="Vista del template"
                data-id="<%= selAttr %>" data-html="<%= datosHtml %>"></iframe>
      </div>
      <% } else { %>
      <div class="espera" id="espera">Elige un template.</div>
      <% } %>
    </main>
  </div>

  <div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalT">
    <div class="modal__caja">
      <div class="modal__cab">
        <h2 id="modalT">Enviar a Workfront</h2>
        <button type="button" class="modal__x" id="modalX" aria-label="Cerrar">&#x2715;</button>
      </div>
      <div class="modal__cuerpo" id="modalC"></div>
      <div class="modal__pie">
        <button type="button" class="modal__cancel" id="modalCancel">Cancelar</button>
        <button type="button" class="modal__ok" id="modalOk">Enviar ahora</button>
      </div>
    </div>
  </div>
<script>
(function () {
  // URL del webhook de Workfront. Dejala VACIA en el repo; pegala solo en Campaign.
  var WORKFRONT_URL = "";

  // ---------------- Logica pura (testeable sin DOM) ----------------
  // BEGIN-PODA
  // Los delimitadores se arman por partes para que el servidor no los tome por codigo.
  var O = "<" + "%", C = "%" + ">";
  function rx(s, f) { return new RegExp(s, f || "g"); }
  function esc(s) {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }
  // Quita tildes y pasa a minusculas, para buscar sin acentos.
  function norm(s) {
    s = String(s).toLowerCase();
    var de = "\u00e1\u00e0\u00e4\u00e2\u00e9\u00e8\u00eb\u00ea\u00ed\u00ec\u00ef\u00ee\u00f3\u00f2\u00f6\u00f4\u00fa\u00f9\u00fc\u00fb\u00f1\u00e7";
    var a  = "aaaaeeeeiiiioooouuuunc";
    var o = "", i, j;
    for (i = 0; i < s.length; i++) { j = de.indexOf(s.charAt(i)); o += j < 0 ? s.charAt(i) : a.charAt(j); }
    return o;
  }

  // Mini evaluador SEGURO: solo targetData.X / recipient.X, textos, ==, !=, ===, !==, &&, ||, !, ( )
  // No usa eval ni Function: el contenido guardado no puede ejecutar codigo aqui.
  function tokenizar(s) {
    s = String(s).replace(/^\s+|\s+$/g, "");
    var re = /\s*(?:('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*")|([A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*)|(\d+(?:\.\d+)?)|(===|!==|==|!=|&&|\|\||!|\(|\)))\s*/g;
    var out = [], pos = 0, m;
    while (pos < s.length) {
      re.lastIndex = pos;
      m = re.exec(s);
      if (!m || m.index !== pos) throw new Error("token");
      if (m[1] !== undefined) out.push({ t: "str", v: m[1].slice(1, -1).replace(/\\(.)/g, "$1") });
      else if (m[2] !== undefined) out.push({ t: "id", v: m[2] });
      else if (m[3] !== undefined) out.push({ t: "num", v: m[3] });
      else out.push({ t: "op", v: m[4] });
      pos = re.lastIndex;
    }
    return out;
  }

  function evaluar(cond, perfil) {
    var tk = tokenizar(cond), i = 0;
    function esOp(v) { var t = tk[i]; return !!t && t.t === "op" && t.v === v; }
    function pOr() { var a = pAnd(); while (esOp("||")) { i++; var b = pAnd(); a = a || b; } return a; }
    function pAnd() { var a = pNot(); while (esOp("&&")) { i++; var b = pNot(); a = a && b; } return a; }
    function pNot() { if (esOp("!")) { i++; return !pNot(); } return pCmp(); }
    function pCmp() {
      var a = pPrim(), t = tk[i];
      if (t && t.t === "op" && (t.v === "==" || t.v === "===" || t.v === "!=" || t.v === "!==")) {
        i++;
        var b = pPrim(), eq = String(a) === String(b);
        return (t.v === "==" || t.v === "===") ? eq : !eq;
      }
      return a;
    }
    function pPrim() {
      var t = tk[i++];
      if (!t) throw new Error("fin");
      if (t.t === "op" && t.v === "(") {
        var v = pOr();
        if (!esOp(")")) throw new Error("paren");
        i++;
        return v;
      }
      if (t.t === "str" || t.t === "num") return t.v;
      if (t.t === "id") {
        var m = /^(?:targetData|recipient)\.(\w+)$/.exec(t.v);
        if (m) return perfil[m[1]] === undefined ? "" : perfil[m[1]];
        if (t.v === "true") return true;
        if (t.v === "false") return false;
        if (t.v === "null") return "";
      }
      throw new Error("no soportado");
    }
    var r = pOr();
    if (i !== tk.length) throw new Error("sobra");
    return !!r;
  }

  function reGrupo() {
    return rx(O + "\\/\\*\\s*\\[acr-dc-start-group\\([^)]*\\)\\]\\s*\\*\\/" + C +
      "((?:(?!" + O + "\\/\\*\\s*\\[acr-dc-start-group)[\\s\\S])*?)" +
      O + "\\/\\*\\s*\\[acr-dc-end-group\\]\\s*\\*\\/" + C);
  }
  function reRama() {
    return rx(O + "\\s*\\}?\\s*(?:else\\s+)?(?:if\\s*\\(([\\s\\S]*?)\\)\\s*)?\\{\\s*" + C +
      "\\s*" + O + "\\/\\*\\s*\\[acr-dc-start-cond\\(([\\s\\S]*?)\\)\\]\\s*\\*\\/" + C +
      "([\\s\\S]*?)" + O + "\\/\\*\\s*\\[acr-dc-end-cond\\]\\s*\\*\\/" + C);
  }

  // Valores de muestra: los tokens de personalizacion se reemplazan por estos valores.
  // Lo que no este aqui se ve como [CAMPO]. Son datos FICTICIOS.
  var diccionario = {
    "firstName": "Ana",
    "bcpSaludoEnaltaPrivVIEW6": "Estimada Ana",
    "bcpSoloPrimerNombre": "Ana",
    "DESNBREENNPRINCIPAL": "MARIA LOPEZ DEMO",
    "NBRFUNCIONARIO": "PEDRO GOMEZ DEMO",
    "DESCORREOEENNPRINCIPAL": "ejecutivo@example.com",
    "DESCORREOFUNCIONARIO": "ejecutivo@example.com",
    "DESCELULAREENNPRINCIPAL": "987654321",
    "NUMTELEFONOFUNCIONARIO": "987654321",
    "TCEA": "45.8",
    "FECINICIOVIGENCIACAMPANIA": "01/01/1940",
    "FECFINVIGENCIACAMPANIA": "01/01/1940",
    "FECFINVIGENCIACAMPANIAL": "01/01/1940",
    "MTOOFERTASOL": "3,000"
  };

  // Diccionario traduccion UI
  var DICCIONARIO_UI = {
      "CODSUBSEGMENTO": "SEGMENTO",
      "CODPRODUCTO": "PRODUCTO",
      "M1N": "CONSUMO",
      "X1N": "BEX",
      "TCRCLL": "LATAM Clasica",
      "TCRORL": "LATAM Oro",
      "TCRPLL": "LATAM Platinum",
      "TCRPL1": "LATAM Signature",
      "TCRBA7": "LATAM Sapphire",
      "AMXCLL": "Amex Clasica",
      "AMXGLL": "Amex Oro",
      "AMXPLL": "Amex Platinum",
      "AMXGRE": "Amex Black",
      "TCRLY5": "Qore Clasica",
      "TCRLY4": "Qore Platinum",
      "TCRLY3": "Qore Oro",
      "TCRLY2": "Qore Signature",
      "TCRLY1": "Qore Infinite"
  };

  // Funcion auxiliar para obtener la etiqueta visible
  function traducirUI(clave) {
      return DICCIONARIO_UI[clave] || clave;
  }
  function valorMuestra(k) {
    var v = diccionario[k];
    return (v !== undefined && v !== null && v !== "") ? esc(v) : null;
  }

  // opciones: { todas:bool, muestra:bool }
  // devuelve { html, elegidas:[{grupo,label}], noEval, noEvalTextos:[], includes:[], sinValor:[] }
  function podar(src, perfil, opciones) {
    opciones = opciones || {};
    var todas = !!opciones.todas;
    var conMuestra = opciones.muestra !== false;
    var elegidas = [], noEval = 0, noEvalTextos = [], includes = [], sinValor = [];
    var nGrupo = 0, guard = 0, out = src, prev;
    function anota(lista, v) { if (lista.indexOf(v) < 0) lista.push(v); }
    do {
      prev = out;
      out = out.replace(reGrupo(), function (m, body) {
        var ramas = [], r = reRama(), mm;
        while ((mm = r.exec(body))) {
          var partes = mm[2].split(",");
          ramas.push({
            cond: mm[1],
            label: partes.slice(0, Math.max(1, partes.length - 2)).join(","),
            html: mm[3]
          });
        }
        if (!ramas.length) return m;
        nGrupo++;
        var k, pick = -1;
        if (todas) {
          var acc = "";
          for (k = 0; k < ramas.length; k++) {
            acc += "<div style='font:11px Arial,sans-serif;background:#eef2ff;color:#4338ca;padding:2px 8px;'>RAMA: " +
                   esc(ramas[k].label) + "</div>" + ramas[k].html;
          }
          elegidas.push({ grupo: nGrupo, label: "todas", todas: true });
          return acc;
        }
        for (k = 0; k < ramas.length; k++) {
          if (ramas[k].cond === undefined) { pick = k; break; }
          try {
            if (evaluar(ramas[k].cond, perfil)) { pick = k; break; }
          } catch (e) { noEval++; anota(noEvalTextos, String(ramas[k].cond).replace(/\s+/g, " ")); }
        }
        if (pick < 0) { elegidas.push({ grupo: nGrupo, label: "", sin: true }); return ""; }
        elegidas.push({ grupo: nGrupo, label: ramas[pick].label });
        return ramas[pick].html;
      });
    } while (out !== prev && ++guard < 20);

    // Limpieza del codigo de Campaign que queda
    out = out.replace(rx(O + "\\/\\*[\\s\\S]*?\\*\\/" + C), "");
    out = out.replace(rx(O + "@\\s*include\\s+view\\s*=\\s*['\"]([^'\"]+)['\"]\\s*" + C),
      function (m, n) {
        if (valorMuestra(n) === null) anota(sinValor, n);
        var x = conMuestra ? valorMuestra(n) : null;
        return x !== null ? x : "[" + esc(n) + "]";
      });
    out = out.replace(rx(O + "@\\s*include\\s+fragment\\s*=\\s*['\"]([^'\"]+)['\"]\\s*" + C),
      function (m, n) {
        anota(includes, n);
        return "<div style='font:11px Arial,sans-serif;background:#fef3c7;color:#92400e;padding:6px 8px;text-align:center;'>[fragmento " +
               esc(n) + " no resuelto]</div>";
      });
    out = out.replace(rx(O + "=([\\s\\S]*?)" + C),
      function (m, e) {
        var t = /(?:targetData|recipient)\.(\w+)/.exec(e) || /(\b[a-zA-Z_]\w*\b)/.exec(e);
        var key = t ? t[1] : null;
        if (key && valorMuestra(key) === null) anota(sinValor, key);
        var x = (conMuestra && key) ? valorMuestra(key) : null;
        return x !== null ? x : "[" + (key || "...") + "]";
      });
    out = out.replace(rx(O + "[\\s\\S]*?" + C), "");
    return { html: out, elegidas: elegidas, noEval: noEval, noEvalTextos: noEvalTextos,
             includes: includes, sinValor: sinValor };
  }

  // Variables usadas en las condiciones y los valores con que se comparan
  function detectar(src) {
    var conds = [], m;
    var r = rx(O + "\\s*\\}?\\s*(?:else\\s+)?if\\s*\\(([\\s\\S]*?)\\)\\s*\\{\\s*" + C +
               "\\s*" + O + "\\/\\*\\s*\\[acr-dc-start-cond");
    while ((m = r.exec(src))) conds.push(m[1]);
    var vars = {}, orden = [], k, mm;
    for (k = 0; k < conds.length; k++) {
      var rv = /(?:targetData|recipient)\.(\w+)/g;
      while ((mm = rv.exec(conds[k]))) {
        if (!vars[mm[1]]) { vars[mm[1]] = { lits: [] }; orden.push(mm[1]); }
      }
      var rl = /(?:targetData|recipient)\.(\w+)\s*(?:===?|!==?)\s*(?:'([^']*)'|"([^"]*)")/g;
      while ((mm = rl.exec(conds[k]))) {
        var lit = mm[2] !== undefined ? mm[2] : mm[3];
        if (vars[mm[1]].lits.indexOf(lit) < 0) vars[mm[1]].lits.push(lit);
      }
    }
    // tipo: "valores" si se compara con textos no vacios; "presencia" si solo con ''
    for (k = 0; k < orden.length; k++) {
      var lits = vars[orden[k]].lits, reales = [];
      for (var j = 0; j < lits.length; j++) if (lits[j] !== "") reales.push(lits[j]);
      vars[orden[k]].reales = reales;
      vars[orden[k]].tipo = reales.length ? "valores" : "presencia";
    }
    return { orden: orden, vars: vars, n: conds.length };
  }

  // Agrupa banderas de presencia que se parecen (prefijo largo, o prefijo + sufijo comunes),
  // p.ej. DESCORREOEENNPRINCIPAL / DESNBREENNPRINCIPAL / DESCELULAREENNPRINCIPAL.
  // Devuelve [{ prefijo, sufijo, etiqueta, nombres:[] }]; las sueltas van en grupos de uno.
  function comunIni(a, b) {
    var n = Math.min(a.length, b.length), i = 0;
    while (i < n && a.charAt(i) === b.charAt(i)) i++;
    return a.slice(0, i);
  }
  function comunFin(a, b) {
    var n = Math.min(a.length, b.length), i = 0;
    while (i < n && a.charAt(a.length - 1 - i) === b.charAt(b.length - 1 - i)) i++;
    return i ? a.slice(a.length - i) : "";
  }
  function parecidos(a, b) {
    var p = comunIni(a, b).length, sf = comunFin(a, b).length;
    return p >= 4 || (p >= 3 && sf >= 6);
  }
  // URL a la que navega el buscador al elegir un template.
  function urlTemplate(id) { return "?frgId=" + encodeURIComponent(id); }

  function agrupar(nombres) {
    var usados = {}, salida = [], i, j;
    for (i = 0; i < nombres.length; i++) {
      if (usados[nombres[i]]) continue;
      usados[nombres[i]] = 1;
      var grupo = [nombres[i]];
      for (j = i + 1; j < nombres.length; j++) {
        if (usados[nombres[j]]) continue;
        if (parecidos(nombres[i], nombres[j])) { usados[nombres[j]] = 1; grupo.push(nombres[j]); }
      }
      var pre = grupo[0], suf = grupo[0];
      for (j = 1; j < grupo.length; j++) { pre = comunIni(pre, grupo[j]); suf = comunFin(suf, grupo[j]); }
      if (grupo.length < 2) { pre = ""; suf = ""; }
      salida.push({
        prefijo: pre,
        sufijo: suf,
        nombres: grupo,
        etiqueta: grupo.length < 2 ? grupo[0]
          : (pre + "\u2026" + (suf.length >= 4 ? suf : ""))
      });
    }
    return salida;
  }
  // END-PODA

  // ---------------- Elementos ----------------
  var $ = function (id) { return document.getElementById(id); };
  var elCombo = $("combo"), elBuscar = $("buscar"), elLista = $("lista"), elComboId = $("comboId");
  var elInfo = $("info"), elAvisos = $("avisos"), elDetalle = $("detalle");
  var elPanel = $("panel"), elVars = $("vars"), elRamas = $("ramas"), elPanelN = $("panelN");
  var elVista = $("vista"), elMarco = $("marco"), elCinta = $("cinta"), elCintaTxt = $("cintaTxt");
  var elModal = $("modal"), elModalC = $("modalC"), elModalOk = $("modalOk");
  var bWf = $("workfront");

  // ---------------- Estado ----------------
  var TEMPLATES = [], actual = elCombo.getAttribute("data-sel") || "";
  var perfil = {}, det = null, ultimo = null;
  var vista = { w: 700, z: 100, muestra: true, panel: true };
  var ALTO_VISTA = 3000;   // px; alto del iframe del preview (ver aplicarVista)
  var original = elVista ? decodeURIComponent(elVista.getAttribute("data-html") || "") : "";

  function guarda(k, v) { try { localStorage.setItem("prevTpl." + k, v); } catch (e) {} }
  function lee(k) { try { return localStorage.getItem("prevTpl." + k); } catch (e) { return null; } }

  (function cargarTemplates() {
    var lista = (elCombo.getAttribute("data-frags") || "").split(",");
    for (var i = 0; i < lista.length; i++) {
      if (!lista[i]) continue;
      var p = lista[i].split("|");
      var id = decodeURIComponent(p[0]), nom = decodeURIComponent(p[1] || "");
      TEMPLATES.push({ id: id, nom: nom, k: norm(nom) });
      if (id === actual) { elBuscar.value = nom; elComboId.textContent = id; }
    }
  })();

  // ---------------- URL ----------------
  function leerURL() {
    var q = location.search.replace(/^\?/, "").split("&"), i, kv, k, v;
    for (i = 0; i < q.length; i++) {
      if (!q[i]) continue;
      kv = q[i].split("=");
      k = decodeURIComponent(kv[0]); v = decodeURIComponent((kv[1] || "").replace(/\+/g, " "));
      if (k === "w") { if (v === "375" || v === "700") vista.w = parseInt(v, 10); }
      else if (k === "z") { var z = parseInt(v, 10); if (z >= 50 && z <= 100) vista.z = z; }
      else if (k === "muestra") vista.muestra = (v !== "0");
      else if (k.indexOf("v.") === 0) perfil[k.slice(2)] = v;
    }
  }
  function escribirURL() {
    if (!actual) return;
    var q = ["frgId=" + encodeURIComponent(actual)], k;
    for (k = 0; k < det.orden.length; k++) {
      var n = det.orden[k];
      q.push("v." + encodeURIComponent(n) + "=" + encodeURIComponent(perfil[n] === undefined ? "" : perfil[n]));
    }
    if (!vista.muestra) q.push("muestra=0");
    if (vista.w !== 700) q.push("w=" + vista.w);
    if (vista.z !== 100) q.push("z=" + vista.z);
    try { history.replaceState(null, "", location.pathname + "?" + q.join("&")); } catch (e) {}
  }

  // ---------------- Combobox ----------------
  var filtrados = [], iActivo = -1, abierto = false;
  function recientes() {
    var r = (lee("recientes") || "").split(",").filter(function (x) { return !!x; });
    var out = [];
    for (var i = 0; i < r.length; i++) {
      for (var j = 0; j < TEMPLATES.length; j++) if (TEMPLATES[j].id === r[i]) { out.push(TEMPLATES[j]); break; }
    }
    return out.slice(0, 5);
  }
  function anotarReciente(id) {
    var r = (lee("recientes") || "").split(",").filter(function (x) { return x && x !== id; });
    r.unshift(id);
    guarda("recientes", r.slice(0, 5).join(","));
  }
  function filtrar(q) {
    q = norm(q).replace(/^\s+|\s+$/g, "");
    if (!q) return { titulo: recientes().length ? "Recientes" : "Todos", items: recientes().length ? recientes() : TEMPLATES.slice(0, 50) };
    var partes = q.split(/\s+/), out = [], i, j, ok;
    for (i = 0; i < TEMPLATES.length; i++) {
      ok = true;
      for (j = 0; j < partes.length; j++) {
        if (TEMPLATES[i].k.indexOf(partes[j]) < 0 && TEMPLATES[i].id.indexOf(partes[j]) < 0) { ok = false; break; }
      }
      if (ok) out.push(TEMPLATES[i]);
      if (out.length >= 80) break;
    }
    return { titulo: out.length + " resultado" + (out.length === 1 ? "" : "s"), items: out };
  }
  function resaltar(nodo, texto, q) {
    q = norm(q).replace(/^\s+|\s+$/g, "").split(/\s+/)[0];
    var i = q ? norm(texto).indexOf(q) : -1;
    if (i < 0) { nodo.textContent = texto; return; }
    nodo.appendChild(document.createTextNode(texto.slice(0, i)));
    var b = document.createElement("span");
    b.className = "combo__marca";
    b.textContent = texto.slice(i, i + q.length);
    nodo.appendChild(b);
    nodo.appendChild(document.createTextNode(texto.slice(i + q.length)));
  }
  function pintarLista() {
    var r = filtrar(elBuscar.value);
    filtrados = r.items; iActivo = -1;
    elLista.textContent = "";
    var t = document.createElement("div");
    t.className = "combo__gt";
    t.textContent = r.titulo;
    elLista.appendChild(t);
    if (!filtrados.length) {
      var v = document.createElement("div");
      v.className = "combo__vacio";
      v.textContent = "Sin resultados. Prueba con menos palabras o con el id.";
      elLista.appendChild(v);
      return;
    }
    for (var i = 0; i < filtrados.length; i++) {
      (function (tpl, idx) {
        var it = document.createElement("div");
        it.className = "combo__item";
        it.id = "opt" + idx;
        it.setAttribute("role", "option");
        it.setAttribute("aria-selected", tpl.id === actual ? "true" : "false");
        it.title = tpl.nom;
        var n = document.createElement("span");
        n.className = "combo__nom";
        resaltar(n, tpl.nom, elBuscar.value);
        var d = document.createElement("span");
        d.className = "combo__id";
        d.textContent = tpl.id;
        it.appendChild(n); it.appendChild(d);
        it.onmousedown = function (ev) { ev.preventDefault(); ir(tpl.id); };
        elLista.appendChild(it);
      })(filtrados[i], i);
    }
  }
  function marcarActivo(n) {
    var nodos = elLista.querySelectorAll(".combo__item"), i;
    for (i = 0; i < nodos.length; i++) nodos[i].className = "combo__item";
    if (n >= 0 && nodos[n]) {
      nodos[n].className = "combo__item combo__item--activo";
      elBuscar.setAttribute("aria-activedescendant", nodos[n].id);
      if (nodos[n].scrollIntoView) nodos[n].scrollIntoView({ block: "nearest" });
    } else {
      elBuscar.removeAttribute("aria-activedescendant");
    }
  }
  function abrir() {
    abierto = true;
    elCombo.className = "combo combo--abierto";
    elBuscar.setAttribute("aria-expanded", "true");
    pintarLista();
  }
  function cerrar() {
    abierto = false;
    elCombo.className = "combo";
    elBuscar.setAttribute("aria-expanded", "false");
    elBuscar.removeAttribute("aria-activedescendant");
    var t = null, i;
    for (i = 0; i < TEMPLATES.length; i++) if (TEMPLATES[i].id === actual) t = TEMPLATES[i];
    elBuscar.value = t ? t.nom : "";
  }
  function ir(id) {
    anotarReciente(id);
    location.href = location.pathname + urlTemplate(id);
  }
  elBuscar.onfocus = abrir;
  elBuscar.oninput = function () { if (!abierto) abrir(); else pintarLista(); };
  elBuscar.onblur = function () { setTimeout(cerrar, 120); };
  elBuscar.onkeydown = function (ev) {
    if (ev.key === "ArrowDown" || ev.key === "ArrowUp") {
      ev.preventDefault();
      if (!abierto) { abrir(); return; }
      iActivo += (ev.key === "ArrowDown" ? 1 : -1);
      if (iActivo < 0) iActivo = filtrados.length - 1;
      if (iActivo >= filtrados.length) iActivo = 0;
      marcarActivo(iActivo);
    } else if (ev.key === "Enter") {
      if (abierto && filtrados.length) { ev.preventDefault(); ir(filtrados[iActivo >= 0 ? iActivo : 0].id); }
    } else if (ev.key === "Escape") {
      if (abierto) { ev.preventDefault(); elBuscar.blur(); }
    }
  };

  // ---------------- Panel de escenario ----------------
  var ETIQ_VACIO = "(vac\u00edo)", ETIQ_OTRO = "(otro valor)", VAL_OTRO = "otro";

  function valorPorDefecto(v) { return v.reales.length ? v.reales[0] : VAL_OTRO; }

  // Para variables de tipo "valores" el escenario solo puede ser uno de los valores reales.
  function normalizarPerfil() {
    for (var i = 0; i < det.orden.length; i++) {
      var n = det.orden[i], v = det.vars[n];
      if (v.tipo !== "valores") continue;
      var ok = false;
      for (var j = 0; j < v.reales.length; j++) if (perfil[n] === v.reales[j]) ok = true;
      if (!ok) perfil[n] = valorPorDefecto(v);
    }
  }

  function pintarEscenario() {
    elVars.textContent = "";
    if (!det.orden.length) {
      var p = document.createElement("div");
      p.className = "panel__vacio";
      p.textContent = "Este template no tiene contenido condicional.";
      elVars.appendChild(p);
      elPanelN.textContent = "sin variables";
      return;
    }
    elPanelN.textContent = det.orden.length + " variable" + (det.orden.length === 1 ? "" : "s");

    var valores = [], presencia = [], i;
    for (i = 0; i < det.orden.length; i++) {
      (det.vars[det.orden[i]].tipo === "valores" ? valores : presencia).push(det.orden[i]);
    }
    for (i = 0; i < valores.length; i++) elVars.appendChild(cajaValores(valores[i]));
    var grupos = agrupar(presencia);
    for (i = 0; i < grupos.length; i++) elVars.appendChild(cajaPresencia(grupos[i]));
  }

  function cabecera(nombre, tipo) {
    var c = document.createElement("div");
    c.className = "vars__cab";
    var n = document.createElement("span");
    n.className = "vars__nom";
    n.textContent = traducirUI(nombre);
    n.title = nombre;
    var t = document.createElement("span");
    t.className = "vars__tipo";
    t.textContent = tipo;
    c.appendChild(n); c.appendChild(t);
    return c;
  }

  function cajaValores(nombre) {
    var v = det.vars[nombre], g = document.createElement("div");
    g.className = "vars__g";
    g.appendChild(cabecera(nombre, "valores"));
    var seg = document.createElement("div");
    seg.className = "vars__seg" + (v.reales.length === 1 ? " vars__seg--uno" : "");
    seg.setAttribute("role", "group");
    seg.setAttribute("aria-label", nombre);
    // Solo los valores que el template compara de verdad. "(otro valor)" y "(vacio)" caian
    // siempre en la rama por defecto, que suele estar vacia, y se veia como si no hubiera nada.
    var ops = [], i;
    for (i = 0; i < v.reales.length; i++) ops.push([v.reales[i], traducirUI(v.reales[i])]);
    for (i = 0; i < ops.length; i++) {
      (function (val, txt) {
        var b = document.createElement("button");
        b.type = "button";
        b.textContent = txt;
        b.title = val;
        b.setAttribute("aria-pressed", perfil[nombre] === val ? "true" : "false");
        b.onclick = function () { perfil[nombre] = val; pintarEscenario(); pintar(); };
        seg.appendChild(b);
      })(ops[i][0], ops[i][1]);
    }
    g.appendChild(seg);
    return g;
  }

  function interruptor(nombre, esGrupo) {
    var b = document.createElement("button");
    b.type = "button";
    b.className = "vars__sw" + (esGrupo ? " vars__sw--todos" : "");
    b.setAttribute("role", "switch");
    var p = document.createElement("span"); p.className = "sw__p";
    var n = document.createElement("span"); n.className = "sw__n";
    n.textContent = nombre; b.title = nombre;
    var e = document.createElement("span"); e.className = "sw__e";
    b.appendChild(p); b.appendChild(n); b.appendChild(e);
    b.actualizar = function (estado) {
      b.setAttribute("aria-checked", estado);
      e.textContent = estado === "true" ? "con dato" : (estado === "mixed" ? "parcial" : ETIQ_VACIO);
    };
    return b;
  }

  function cajaPresencia(grupo) {
    var g = document.createElement("div"), i;
    g.className = "vars__g";
    if (grupo.nombres.length === 1) {
      g.appendChild(cabecera(grupo.nombres[0], "presencia"));
      var uno = interruptor("estado", false);
      uno.actualizar(perfil[grupo.nombres[0]] === "" ? "false" : "true");
      uno.onclick = function () {
        perfil[grupo.nombres[0]] = (perfil[grupo.nombres[0]] === "" ? VAL_OTRO : "");
        pintarEscenario(); pintar();
      };
      g.appendChild(uno);
      return g;
    }
    var conDato = 0;
    for (i = 0; i < grupo.nombres.length; i++) if (perfil[grupo.nombres[i]] !== "") conDato++;
    g.appendChild(cabecera(grupo.etiqueta, grupo.nombres.length + " banderas \u00b7 " + conDato + "/" + grupo.nombres.length + " con dato"));
    var todos = interruptor("todos", true);
    todos.actualizar(conDato === grupo.nombres.length ? "true" : (conDato === 0 ? "false" : "mixed"));
    todos.onclick = function () {
      var nuevo = (conDato === grupo.nombres.length) ? "" : VAL_OTRO;
      for (var j = 0; j < grupo.nombres.length; j++) perfil[grupo.nombres[j]] = nuevo;
      pintarEscenario(); pintar();
    };
    g.appendChild(todos);
    for (i = 0; i < grupo.nombres.length; i++) {
      (function (nombre) {
        var sw = interruptor(nombre, false);
        sw.actualizar(perfil[nombre] === "" ? "false" : "true");
        sw.onclick = function () {
          perfil[nombre] = (perfil[nombre] === "" ? VAL_OTRO : "");
          pintarEscenario(); pintar();
        };
        g.appendChild(sw);
      })(grupo.nombres[i]);
    }
    return g;
  }

  function pintarRamas(elegidas) {
    elRamas.textContent = "";
    if (!det.n) return;
    var t = document.createElement("div");
    t.className = "ramas__t";
    t.textContent = "Ramas activas";
    elRamas.appendChild(t);
    if (!elegidas.length) {
      var v = document.createElement("div");
      v.className = "panel__vacio";
      v.textContent = "Ning\u00fan grupo condicional en la vista.";
      elRamas.appendChild(v);
    }
    for (var i = 0; i < elegidas.length; i++) {
      var f = document.createElement("div");
      f.className = "ramas__f";
      var g = document.createElement("span");
      g.className = "ramas__g";
      g.textContent = "Grupo " + elegidas[i].grupo + " \u2192";
      var c = document.createElement("span");
      c.className = "ramas__chip" + (elegidas[i].sin ? " ramas__chip--sin" : "");
      c.textContent = elegidas[i].sin ? "sin rama activa" : elegidas[i].label;
      c.title = c.textContent;
      f.appendChild(g); f.appendChild(c);
      elRamas.appendChild(f);
    }
  }

  // ---------------- Avisos y detalle ----------------
  var detalleAbierto = false;
  function pintarAvisos(r) {
    elAvisos.textContent = "";
    var partes = [];
    if (r.noEval) partes.push(r.noEval + " condici\u00f3n(es) no evaluable(s): se omiti\u00f3 esa rama.");
    if (r.includes.length) partes.push(r.includes.length + " fragmento(s) no resuelto(s).");
    if (!partes.length && !r.sinValor.length) { elAvisos.hidden = true; cerrarDetalle(); return; }
    elAvisos.hidden = false;
    elAvisos.className = "avisos";
    var s = document.createElement("span");
    s.textContent = partes.length ? partes.join(" \u00b7 ") : r.sinValor.length + " token(s) sin valor de muestra.";
    elAvisos.appendChild(s);
    var b = document.createElement("button");
    b.type = "button";
    b.className = "avisos__b";
    b.textContent = detalleAbierto ? "Ocultar detalle" : "Ver detalle";
    b.onclick = function () { detalleAbierto = !detalleAbierto; pintarDetalle(ultimo); pintarAvisos(ultimo); };
    elAvisos.appendChild(b);
  }
  function cerrarDetalle() { detalleAbierto = false; elDetalle.className = "detalle"; elDetalle.textContent = ""; }
  function columna(titulo, items, vacio) {
    var c = document.createElement("div");
    c.className = "detalle__col";
    var t = document.createElement("div");
    t.className = "detalle__t";
    t.textContent = titulo + " (" + items.length + ")";
    c.appendChild(t);
    if (!items.length) {
      var v = document.createElement("div");
      v.textContent = vacio;
      c.appendChild(v);
      return c;
    }
    var ul = document.createElement("ul");
    for (var i = 0; i < items.length; i++) {
      var li = document.createElement("li");
      li.className = "mono";
      li.textContent = items[i];
      ul.appendChild(li);
    }
    c.appendChild(ul);
    return c;
  }
  function pintarDetalle(r) {
    elDetalle.textContent = "";
    if (!detalleAbierto || !r) { elDetalle.className = "detalle"; return; }
    elDetalle.className = "detalle detalle--abierto";
    elDetalle.appendChild(columna("Condiciones no evaluables", r.noEvalTextos, "ninguna"));
    elDetalle.appendChild(columna("Fragmentos no resueltos", r.includes, "ninguno"));
    elDetalle.appendChild(columna("Tokens sin valor de muestra", r.sinValor, "ninguno"));
  }

  // ---------------- Pintar ----------------
  function aplicarVista() {
    if (!elVista) return;
    elVista.setAttribute("width", vista.w);
    elMarco.style.width = vista.w + "px";
    elMarco.style.transform = vista.z === 100 ? "" : "scale(" + (vista.z / 100) + ")";
    elMarco.className = "marco" + (vista.muestra ? " marco--muestra" : "");
    $("escritorio").setAttribute("aria-pressed", vista.w === 700 ? "true" : "false");
    $("movil").setAttribute("aria-pressed", vista.w === 375 ? "true" : "false");
    $("zval").textContent = vista.z + "%";
    elCintaTxt.textContent = vista.muestra ? "muestra" : "[CAMPOS]";
    elCinta.firstChild.textContent = vista.muestra ? "\u25C6 Datos de muestra (ficticios)" : "\u25C7 Tokens sin reemplazar";
    // El iframe no se puede medir (sandbox="" lo deja en otro origen), asi que va con un alto
    // fijo holgado y el scroll lo hace .lienzo, no el iframe.
    elVista.style.height = ALTO_VISTA + "px";
    // scale() no achica la caja en el layout: sin esto, con zoom < 100 queda un hueco debajo.
    elMarco.style.marginBottom = vista.z === 100 ? "" : -Math.round(elMarco.offsetHeight * (1 - vista.z / 100)) + "px";
  }
  function pintar() {
    if (!elVista) return;
    var r = podar(original, perfil, { muestra: vista.muestra });
    ultimo = r;
    elVista.srcdoc = r.html;
    var txt = r.elegidas.length ? r.elegidas.length + " grupo(s) condicional(es)" : "guardado en Campaign";
    elInfo.textContent = txt;
    elInfo.title = txt;
    pintarRamas(r.elegidas);
    pintarAvisos(r);
    pintarDetalle(r);
    aplicarVista();
    escribirURL();
  }

  // ---------------- Acciones ----------------
  if (elVista) {
    det = detectar(original);
    leerURL();
    for (var q = 0; q < det.orden.length; q++) {
      var nq = det.orden[q];
      if (perfil[nq] === undefined) perfil[nq] = valorPorDefecto(det.vars[nq]);
    }
    if (lee("muestra") === "0" && location.search.indexOf("muestra=") < 0) vista.muestra = false;
    normalizarPerfil();
    pintarEscenario();
    pintar();

    $("escritorio").onclick = function () { vista.w = 700; pintar(); };
    $("movil").onclick = function () { vista.w = 375; pintar(); };
    $("zmas").onclick = function () { vista.z = Math.min(100, vista.z + 10); pintar(); };
    $("zmenos").onclick = function () { vista.z = Math.max(50, vista.z - 10); pintar(); };
    $("modoMuestra").onclick = function () {
      vista.muestra = !vista.muestra;
      guarda("muestra", vista.muestra ? "1" : "0");
      pintar();
    };
    $("restablecer").onclick = function () {
      for (var i = 0; i < det.orden.length; i++) perfil[det.orden[i]] = valorPorDefecto(det.vars[det.orden[i]]);
      pintarEscenario();
      pintar();
    };
    $("cerrarPanel").onclick = function () {
      vista.panel = false;
      elPanel.hidden = true;
      aplicarVista();
    };
    $("descargar").onclick = function () {
      var url = URL.createObjectURL(new Blob([ultimo.html], { type: "text/html" }));
      var a = document.createElement("a");
      a.href = url;
      a.download = "template-" + (elVista.getAttribute("data-id") || "preview") + ".html";
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 5000);
    };
    $("enlace").onclick = function () {
      var b = $("enlace"), previo = b.textContent;
      function fin(ok) {
        b.textContent = ok ? "Enlace copiado" : "Copia manual: mira la barra de direcciones";
        setTimeout(function () { b.textContent = previo; }, 2500);
      }
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(location.href).then(function () { fin(true); }, function () { fin(false); });
        } else { fin(false); }
      } catch (e) { fin(false); }
    };
    window.onresize = aplicarVista;
    document.onkeydown = function (ev) {
      if (ev.target && (ev.target.tagName === "INPUT" || ev.target.tagName === "TEXTAREA")) return;
      if (ev.key === "/") { ev.preventDefault(); elBuscar.focus(); }
      else if (ev.key === "d" || ev.key === "D") { vista.w = 700; pintar(); }
      else if (ev.key === "m" || ev.key === "M") { vista.w = 375; pintar(); }
      else if (ev.key === "Escape" && elModal.className.indexOf("abierto") > 0) cerrarModal();
    };
  }

  // ---------------- Workfront ----------------
  // Unica llamada de red de la pagina. Siempre pasa por el dialogo.
  var focoPrevio = null;
  function fila(k, v, mono) {
    var f = document.createElement("div");
    f.className = "modal__f";
    var a = document.createElement("div");
    a.className = "modal__k";
    a.textContent = k;
    var b = document.createElement("div");
    b.className = "modal__v" + (mono ? " mono" : "");
    b.textContent = v;
    f.appendChild(a); f.appendChild(b);
    return f;
  }
  function resumenEscenario() {
    var p = [], i;
    for (i = 0; i < det.orden.length; i++) {
      var n = det.orden[i], v = perfil[n];
      p.push(n + "=" + (v === "" ? ETIQ_VACIO : (v === VAL_OTRO ? "con dato" : v)));
    }
    return p.length ? p.join(" \u00b7 ") : "sin variables";
  }
  function resumenRamas() {
    var p = [], i;
    for (i = 0; i < ultimo.elegidas.length; i++) {
      var e = ultimo.elegidas[i];
      p.push("Grupo " + e.grupo + " \u2192 " + (e.sin ? "sin rama activa" : e.label));
    }
    return p.length ? p.join("; ") : "sin grupos condicionales";
  }
  function nombreActual() {
    for (var i = 0; i < TEMPLATES.length; i++) if (TEMPLATES[i].id === actual) return TEMPLATES[i].nom;
    return "";
  }
  function cerrarModal() {
    elModal.className = "modal";
    if (focoPrevio && focoPrevio.focus) focoPrevio.focus();
  }
  function abrirModal() {
    focoPrevio = document.activeElement;
    elModalC.textContent = "";
    elModalC.appendChild(fila("Template", nombreActual() + "  (" + actual + ")"));
    elModalC.appendChild(fila("Escenario", resumenEscenario(), true));
    elModalC.appendChild(fila("Ramas", resumenRamas(), true));
    elModalC.appendChild(fila("Vista", (vista.w === 700 ? "Escritorio 700 px" : "M\u00f3vil 375 px") + " \u00b7 " + vista.z + "%"));
    elModalC.appendChild(fila("Destino", WORKFRONT_URL, true));
    var n = document.createElement("div");
    n.className = "modal__nota";
    n.textContent = vista.muestra
      ? "\u25C6 El HTML que se env\u00eda lleva valores de muestra (S/3,000, 45.8%, MARIA LOPEZ DEMO) y [CAMPO] donde no hay valor. No son datos reales del cliente."
      : "\u25C7 El HTML que se env\u00eda lleva los tokens sin reemplazar ([CAMPO]).";
    elModalC.appendChild(n);
    elModalOk.disabled = false;
    elModalOk.textContent = "Enviar ahora";
    elModal.className = "modal modal--abierto";
    elModalOk.focus();
  }
  function avisoWf(ok, texto, detalle) {
    elAvisos.hidden = false;
    elAvisos.className = "avisos" + (ok ? "" : " avisos--error");
    elAvisos.textContent = "";
    var s = document.createElement("span");
    s.textContent = texto;
    elAvisos.appendChild(s);
    if (detalle) {
      var d = document.createElement("span");
      d.className = "mono";
      d.textContent = detalle;
      elAvisos.appendChild(d);
    }
    var b = document.createElement("button");
    b.type = "button";
    b.className = "avisos__b";
    b.textContent = "Cerrar";
    b.onclick = function () { pintarAvisos(ultimo); };
    elAvisos.appendChild(b);
  }
  function estadoWf(txt, dis) { bWf.textContent = txt; bWf.disabled = !!dis; }

  if (bWf) {
    if (!WORKFRONT_URL) {
      estadoWf("Workfront no configurado", true);
      bWf.title = "Falta la URL del webhook en el .jssp. Mientras tanto, usa Descargar .html y subelo a mano.";
    }
    bWf.onclick = function () {
      if (!WORKFRONT_URL) return;
      abrirModal();
    };
    $("modalX").onclick = cerrarModal;
    $("modalCancel").onclick = cerrarModal;
    elModal.onmousedown = function (ev) { if (ev.target === elModal) cerrarModal(); };
    elModalOk.onclick = function () {
      if (!WORKFRONT_URL) return;
      elModalOk.disabled = true;
      elModalOk.textContent = "Enviando\u2026";
      estadoWf("Enviando\u2026", true);
      var payload = {
        templateId: elVista.getAttribute("data-id") || "",
        nombreTemplate: nombreActual(),
        htmlFinal: ultimo.html,
        fechaEnvio: new Date().toISOString()
      };
      fetch(WORKFRONT_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      })
        .then(function (res) {
          if (!res.ok) throw new Error("HTTP " + res.status);
          cerrarModal();
          estadoWf("\u2713 Enviado", false);
          avisoWf(true, "Enviado a Workfront \u00b7 HTTP " + res.status + " \u00b7 " + nombreActual() + " (" + actual + ")");
          setTimeout(function () { estadoWf("Enviar a Workfront \u2197", false); }, 5000);
        })
        .catch(function (err) {
          cerrarModal();
          estadoWf("\u27f3 Reintentar Workfront", false);
          avisoWf(false, "No se pudo enviar. Si fue un bloqueo del navegador (CORS), el env\u00edo pudo llegar igual: revisa en Workfront antes de reintentar. ", String(err && err.message || err));
        });
    };
  }
})();
</script>
</body>
</html>
