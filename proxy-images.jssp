<%@ page import="xtk:shared/nl.js" %><%
// ==========================================================================
// Proxy de imagenes para "Descargar PNG" de previewFragment.jssp.
// El navegador no puede leer imagenes de dominios sin CORS; el servidor de
// Campaign si. Esta pagina descarga la imagen y la devuelve como texto
// "data:image/...;base64,..." desde el mismo origen que el preview.
// SEGURIDAD: exige sesion y SOLO acepta los dominios/rutas de PERMITIDOS.
// Sin esa lista cualquiera podria usarlo para pedir URLs internas (SSRF).
// En produccion, cambia el dominio de stage13 por el de produccion.
// ==========================================================================
// PRUEBA EN STAGE: login desactivado (el bloque de login falla en esta instancia).
// Resolver y reactivar antes de produccion.
// NL.require("/nl/core/shared/core.js").require("/nl/core/jsspcontext.js");
// var jsspContext = new NL.JSSPContext(request);
// if (!jsspContext.checkAuthentication()) { response.sendError(401); return; }

// En los JSSP de esta instancia la salida va con document.write: response.write
// revienta con 500 (BAS-010063). response.sendError si funciona.
function salida(txt) { document.write(txt); }

var PERMITIDOS = {
  "bcp-mid-stage13-res.adobe-campaign.com": "/res/",
  "cdn.storage.flexigon.io": "/"
};
var TIPOS = { png: "image/png", jpg: "image/jpeg", jpeg: "image/jpeg", gif: "image/gif", webp: "image/webp" };
var PESO_MAX = 5 * 1024 * 1024;

var u = String(request.parameters.u || "");
var m = /^https:\/\/([a-z0-9.-]+)(\/[A-Za-z0-9._~\/-]+\.(png|jpe?g|gif|webp))$/i.exec(u);
var host = m ? m[1].toLowerCase() : "";
if (!m || !PERMITIDOS.hasOwnProperty(host) || m[2].indexOf(PERMITIDOS[host]) !== 0 || m[2].indexOf("..") >= 0) {
  response.sendError(400);
  return;
}

// Sin logonEscalation: HttpClientRequest funciona con la sesion normal y el
// servidor solo pide URLs de PERMITIDOS. Cualquier fallo del origen -> 502.
var datos = "";
try {
  var req = new HttpClientRequest(u);
  req.method = "GET";
  req.execute();
  var r = req.response;
  if (r.code == 200 && r.body) datos = r.body.toBase64();
} catch (e) {
  datos = "";
}
if (!datos || datos.length > PESO_MAX * 1.4) { response.sendError(502); return; }
salida("data:" + TIPOS[m[3].toLowerCase()] + ";base64," + datos);
%>
